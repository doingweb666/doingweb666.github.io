<% var tags = site.tags.toArray().sort(function(a, b) { return a.name.localeCompare(b.name, 'zh-CN'); }); %>
<section class="tags-page">
  <header class="page-head">
    <p class="eyebrow">// TAG_DATABASE</p>
    <h1 class="page-title glitch" data-text="./tags">./tags</h1>
    <p class="page-sub"><%= tags.length %> tags indexed <span class="muted">// select a tag to filter transmissions</span></p>
  </header>

  <% if (tags.length) { %>
  <p class="tag-note"><span class="ps1" aria-hidden="true">$</span> find ./posts -type f | xargs grep -h "tags:" | sort | uniq -c</p>
  <div class="tag-cloud">
    <% tags.forEach(function(tag){ %>
    <a class="tag-cloud__item" href="<%- url_for(tag.path) %>">
      <span class="tag-cloud__hash" aria-hidden="true">#</span><span class="tag-cloud__name"><%= tag.name %></span><span class="tag-cloud__count"><%= tag.length %></span>
    </a>
    <% }); %>
  </div>
  <% } else { %>
  <p class="empty"><span class="ps1">$</span> grep -r "#" ./posts — <span class="muted">no tags found.</span></p>
  <% } %>
</section>
