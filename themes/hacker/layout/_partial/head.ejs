<%
  var metaTitle = page.title
    ? page.title + ' // ' + config.title
    : config.title;
  var rawContent = page.content ? strip_html(page.content).replace(/\s+/g, ' ').trim() : '';
  var metaDesc = page.description || (rawContent ? rawContent.slice(0, 120) : (config.description || ''));
  var canonical = config.url + url_for(page.path || '');
  var ogType = page.layout === 'post' ? 'article' : 'website';
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= metaTitle %></title>
<meta name="description" content="<%= metaDesc %>">
<meta name="author" content="<%= config.author || config.title %>">
<meta name="theme-color" content="#04070f">
<meta name="color-scheme" content="dark">
<% if (config.keywords) { %><meta name="keywords" content="<%= Array.isArray(config.keywords) ? config.keywords.join(',') : config.keywords %>"><% } %>
<meta name="generator" content="Hexo">
<link rel="canonical" href="<%= canonical %>">
<link rel="icon" type="image/svg+xml" href="<%- url_for(theme.favicon || '/img/favicon.svg') %>">
<meta property="og:type" content="<%= ogType %>">
<meta property="og:title" content="<%= metaTitle %>">
<meta property="og:description" content="<%= metaDesc %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= metaTitle %>">
<meta name="twitter:description" content="<%= metaDesc %>">
<%- css('css/style') %>
<script>document.documentElement.className += ' js';</script>
